// This is your Prisma schema file
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RoyaltyCalculation {
  id                     Int      @id @default(autoincrement())
  calculationDate        DateTime @default(now())
  waterGel              Float
  nh4no3                Float
  powderFactor          Float
  totalExplosiveQuantity Float
  blastedRockVolume     Float
  baseRoyalty           Float
  royaltyWithSscl       Float
  totalAmount           Float
} 